    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@lavamoat/allow-scripts": "3.4.1",
    "@lavamoat/preinstall-always-fail": "2.1.1",
    "@singlestore/eslint-plugin-react-hooks-disable-import": "1.0.2",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "24.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.0",
    "eslint-plugin-sonarjs": "4.0.2",
    "globals": "17.3.0",
    "husky": "9.1.7",
    "jsdom": "28.0.0",
    "lint-staged": "16.2.7",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "oxlint-tsgolint": "0.22.1",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
